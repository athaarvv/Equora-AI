# EQUORA AI System Configuration
PORT=5000
NODE_ENV=development

# Gemini API Key (Required for AI Orchestrator)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/equora_ai
MONGODB_URI=mongodb://localhost:27017/equora_ai

# Optional Market & News Data API Keys
MARKET_API_KEY=your_market_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Security
JWT_SECRET=equora_jwt_secret_super_key_2026

# Python Analytics Engine URL
ANALYTICS_SERVICE_URL=http://localhost:8000
